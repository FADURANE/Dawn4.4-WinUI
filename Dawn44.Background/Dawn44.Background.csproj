<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The headless resident. Everything here exists to keep the process small: WinExe so there is no
    console window, NativeAOT so there is no CLR and no JIT, net8.0-windows so no CsWinRT projections
    come along, and invariant globalization so ICU stays out. The measured baseline it has to beat is
    the tray-only WinUI process at 180.1MB working set / 138.3MB private; the target is 7-12MB.

    AOT is safe for what this executable touches: settings are hand-rolled JsonDocument/Utf8JsonWriter
    rather than reflection-based serialization, and Process.Start with Verb="runas" and
    Microsoft.Win32.Registry are both AOT-clean.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Platforms>AnyCPU;x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <RootNamespace>Dawn44.Background</RootNamespace>
    <AssemblyName>Dawn44.Background</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EventSourceSupport>false</EventSourceSupport>
    <!--
      Left on purpose: UseSystemResourceKeys would shrink the binary further but replaces exception
      messages with bare identifiers, and background.log is the only diagnostic this process has.
    -->
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
    <!--
      Size over speed: this process wakes every 15ms to read two key states, so nothing here is hot,
      and a smaller image is a smaller resident working set.
    -->
    <OptimizationPreference>Size</OptimizationPreference>
    <!--
      Both are already the defaults for a WinExe, stated explicitly because either one flipping would
      be expensive and invisible: the server GC would commit a heap per core, and the background GC
      would add a thread plus its own committed budget for a heap that never exceeds a few megabytes.
    -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Caps the gen0 budget at 2MB. With the poll loop no longer allocating per tick there is almost
      nothing left to collect, but this bounds any residual idle drift instead of letting the working
      set coast upward to whatever budget the GC picks from cache size. It has no MSBuild property, so
      it goes through the runtime config directly.
    -->
    <RuntimeHostConfigurationOption Include="System.GC.Gen0Size" Value="2097152" Trim="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dawn44.Core\Dawn44.Core.csproj" />
  </ItemGroup>

</Project>
